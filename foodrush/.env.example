# ─────────────────────────────────────────────────────────────
#  FoodRush — LOCAL DEVELOPMENT .env
#  DO NOT COMMIT THIS FILE
#  These values work with docker-compose out of the box.
#  Replace CHANGE_THIS values with your own API keys.
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=c3ab8ff13720e8ad9047dd39466b3c8974e592c2fa383d4a3960714caef0c4f2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── PostgreSQL — User Service ─────────────────────────────────
POSTGRES_USERS_HOST=postgres-users
POSTGRES_USERS_PORT=5432
POSTGRES_USERS_DB=users_db
POSTGRES_USERS_USER=user_svc
POSTGRES_USERS_PASSWORD=users_dev_pass_2024

# ── PostgreSQL — Order Service ────────────────────────────────
POSTGRES_ORDERS_HOST=postgres-orders
POSTGRES_ORDERS_PORT=5432
POSTGRES_ORDERS_DB=orders_db
POSTGRES_ORDERS_USER=order_svc
POSTGRES_ORDERS_PASSWORD=orders_dev_pass_2024

# ── PostgreSQL — Restaurant Service ──────────────────────────
POSTGRES_RESTAURANTS_HOST=postgres-restaurants
POSTGRES_RESTAURANTS_PORT=5432
POSTGRES_RESTAURANTS_DB=restaurants_db
POSTGRES_RESTAURANTS_USER=restaurant_svc
POSTGRES_RESTAURANTS_PASSWORD=restaurants_dev_pass_2024

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=foodrush
KAFKA_GROUP_ID_USER=user-service-group
KAFKA_GROUP_ID_ORDER=order-service-group
KAFKA_GROUP_ID_DELIVERY=delivery-service-group
KAFKA_GROUP_ID_NOTIFICATION=notification-service-group

# ── Zookeeper ─────────────────────────────────────────────────
ZOOKEEPER_HOST=zookeeper
ZOOKEEPER_PORT=2181

# ── Elasticsearch ─────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_RESTAURANT_INDEX=restaurants
ELASTICSEARCH_DRIVER_INDEX=drivers

# ── Service URLs (used by API Gateway) ───────────────────────
USER_SERVICE_URL=http://user-service:3001
RESTAURANT_SERVICE_URL=http://restaurant-service:3002
ORDER_SERVICE_URL=http://order-service:3003
DELIVERY_SERVICE_URL=http://delivery-service:3004

# ── Service Ports ─────────────────────────────────────────────
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
RESTAURANT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
DELIVERY_SERVICE_PORT=3004

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Email / SMTP ──────────────────────────────────────────────
# Sign up free at https://mailtrap.io → Email Testing → SMTP Settings
# All emails sent in dev are caught here — nothing reaches real inboxes
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=CHANGE_THIS                  # ← paste from Mailtrap
SMTP_PASS=CHANGE_THIS                  # ← paste from Mailtrap
EMAIL_FROM=no-reply@foodrush.app
EMAIL_FROM_NAME=FoodRush

# ── SMS (Twilio) ──────────────────────────────────────────────
# https://twilio.com → free trial, no credit card needed
# You get a test phone number and credits to send real SMS
TWILIO_ACCOUNT_SID=CHANGE_THIS
TWILIO_AUTH_TOKEN=CHANGE_THIS
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Push Notifications (Firebase) ─────────────────────────────
# https://console.firebase.google.com → New project → Project Settings
# → Service accounts → Generate new private key
FCM_PROJECT_ID=CHANGE_THIS
FCM_PRIVATE_KEY=CHANGE_THIS
FCM_CLIENT_EMAIL=CHANGE_THIS

# ── Payment Gateway (Razorpay) ────────────────────────────────
# https://dashboard.razorpay.com → Settings → API Keys → Test mode
# Test keys are free and don't charge real money
RAZORPAY_KEY_ID=CHANGE_THIS
RAZORPAY_KEY_SECRET=CHANGE_THIS
RAZORPAY_WEBHOOK_SECRET=CHANGE_THIS

# ── Google Maps API ───────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Maps JavaScript API + Geocoding API + Directions API
GOOGLE_MAPS_API_KEY=CHANGE_THIS

# ── Monitoring ────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev_2024
PROMETHEUS_PORT=9090
GRAFANA_PORT=3010

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Misc ──────────────────────────────────────────────────────
MAX_FILE_UPLOAD_MB=5
BCRYPT_SALT_ROUNDS=12
OTP_EXPIRY_MINUTES=10